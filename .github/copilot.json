{
  "context": {
    "include": ["src/"],
    "exclude": ["dist/", "node_modules/", "tmp/"]
  },

  "stack": {
    "language": "typescript",
    "ui": "react",
    "build": "vite",
    "architecture": "clean",
    "rules": [
      "strict mode enabled",
      "no implicit any",
      "pure functions in core logic",
      "side effects isolated in adapters",
      "see ./requirements-technical.md for more details"
    ]
  },

  "requirements": {
    "functional": "see doc/requirements-functional.md",
    "technical": "see doc/requirements-technical.md"
  }
}
